@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix ex:    <http://example.org/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass foaf:Person ;

  sh:property [
    sh:path foaf:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Every Person must have exactly one foaf:name."
  ] ;

  sh:property [
    sh:path foaf:knows ;
    sh:minCount 1 ;
    sh:class foaf:Person ;
    sh:message "Every Person must know at least one other Person."
  ] ;

  sh:property [
    sh:path foaf:based_near ;
    sh:maxCount 1 ;
    sh:message "Person can have at most one foaf:based_near value."
  ] .
